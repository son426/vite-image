# `package.json#files` is the publication allowlist. Keep these exclusions as a
# guardrail for tooling that does not honor it.
# Source files
src/
demo/
tsconfig.json
tsup.config.ts
eslint.config.js
pnpm-workspace.yaml
pnpm-lock.yaml

# Development files
*.log
.DS_Store
node_modules/

# Build artifacts (we only want dist/)
*.tsbuildinfo

# Git
.git/
.gitignore

# IDE
.vscode/
.idea/
*.swp
*.swo

# Testing
coverage/
.nyc_output/

# Misc
.env
.env.local
