{
  "name": "@son426/vite-image",
  "version": "1.0.0",
  "description": "A Vite plugin and React component for optimized images with LQIP support using vite-imagetools",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "picomatch": "^4.0.7",
      "rollup": "^4.63.1"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js"
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "files": [
    "dist",
    "client.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "package:check": "pnpm run build && publint && attw --pack . --profile esm-only",
    "prepublishOnly": "pnpm run check && pnpm run package:check"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "image",
    "optimization",
    "lqip",
    "react",
    "imagetools",
    "responsive-images"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/son426/vite-image.git"
  },
  "bugs": {
    "url": "https://github.com/son426/vite-image/issues"
  },
  "homepage": "https://vite-image.web.app",
  "dependencies": {
    "vite-imagetools": "^10.0.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^10.9.1",
    "jsdom": "30.0.1",
    "publint": "^0.3.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
